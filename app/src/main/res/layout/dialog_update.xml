<?xml version="1.0" encoding="utf-8"?>
<!-- 检查更新弹窗：检查中 / 结果 / 下载进度 三相位同壳切换（无闪烁） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ad_bg_dialog"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/text_update_title"
        style="@style/AdDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="检查更新" />

    <FrameLayout
        android:id="@+id/container_update_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <!-- 相位 1：检查中 -->
        <LinearLayout
            android:id="@+id/phase_checking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ProgressBar
                android:id="@+id/progress_checking"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/ad_primary" />

            <TextView
                android:id="@+id/text_checking"
                style="@style/AdDialogBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="正在检查更新…" />
        </LinearLayout>

        <!-- 相位 2：结果 -->
        <TextView
            android:id="@+id/phase_result"
            style="@style/AdDialogBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- 相位 3：下载进度 -->
        <LinearLayout
            android:id="@+id/phase_downloading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_download_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正在下载安装包…"
                android:textColor="@color/ad_text"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/progress_download"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:progressBackgroundTint="@color/ad_input_bg"
                android:progressTint="@color/ad_primary" />

            <TextView
                android:id="@+id/text_download_bytes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ad_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/row_update_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_update_secondary"
            style="@style/AdButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:textColor="@color/ad_text_secondary"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_update_primary"
            style="@style/AdButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:textColor="@color/ad_primary"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
