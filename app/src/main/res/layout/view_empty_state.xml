<?xml version="1.0" encoding="utf-8"?>
<!-- 空态视图（iOS ContentUnavailableView 风格）：图标 + 标题 + 提示 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="48dp"
    android:paddingBottom="48dp">

    <ImageView
        android:id="@+id/image_empty"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ad_cases"
        android:tint="@color/ad_text_tertiary" />

    <TextView
        android:id="@+id/text_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/ad_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/ad_text_tertiary"
        android:textSize="13sp" />
</LinearLayout>
