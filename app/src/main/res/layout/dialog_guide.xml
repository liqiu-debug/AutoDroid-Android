<?xml version="1.0" encoding="utf-8"?>
<!-- 引导弹窗：标题 + 说明 + 「暂不 / 去操作」 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ad_bg_dialog"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/text_guide_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ad_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_guide_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/ad_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_guide_cancel"
            style="@style/AdButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="暂不"
            android:textColor="@color/ad_text_secondary" />

        <Button
            android:id="@+id/btn_guide_ok"
            style="@style/AdButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:textColor="@color/ad_primary" />
    </LinearLayout>
</LinearLayout>
