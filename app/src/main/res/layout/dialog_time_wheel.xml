<?xml version="1.0" encoding="utf-8"?>
<!-- 时间滚轮弹窗：iOS 闹钟风格（小时/分钟两列滚动 + 中间高亮带） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ad_bg_dialog"
    android:orientation="vertical"
    android:paddingTop="18dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择时间"
            android:textColor="@color/ad_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_time_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ad_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="216dp"
        android:layout_marginTop="6dp">

        <View
            android:id="@+id/wheel_band"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ad_bg_wheel_band" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/wheel_hour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="4dp"
                    android:text="时"
                    android:textColor="@color/ad_text_tertiary"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/wheel_minute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="4dp"
                    android:text="分"
                    android:textColor="@color/ad_text_tertiary"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/btn_time_cancel"
            style="@style/AdButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="取消"
            android:textColor="@color/ad_text_secondary" />

        <Button
            android:id="@+id/btn_time_ok"
            style="@style/AdButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="确定"
            android:textColor="@color/ad_primary" />
    </LinearLayout>
</LinearLayout>
