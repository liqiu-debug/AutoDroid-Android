<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="#1F2329"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="服务器地址"
            android:textColor="#646A73"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://host:8000"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="设备名（平台设备中心展示）"
            android:textColor="#646A73"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="如：工位A-OPPO"
            android:inputType="text"
            android:maxLines="1" />

        <Switch
            android:id="@+id/switch_notify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="执行后发送飞书通知（默认开关，单次运行可覆盖）" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="保存设置" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#E5E6EB" />

        <TextView
            android:id="@+id/text_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#646A73"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="打开系统无障碍设置" />

        <Button
            android:id="@+id/btn_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="加入电池优化白名单（防后台被杀）" />

        <Button
            android:id="@+id/btn_autojs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="打开 AutoJs6 控制台（高级）" />

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="退出登录" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="AutoDroid Runner · 执行引擎 AutoJs6 6.7.0（冻结基线）"
            android:textColor="#A9AEB8"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
