<?xml version="1.0" encoding="utf-8"?>
<!-- 通用选择弹窗（用例/场景目标选择、目录选择）：圆角卡片 + 搜索 + 高度自适应列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ad_bg_dialog"
    android:orientation="vertical"
    android:paddingTop="18dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/text_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ad_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_dialog_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ad_text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/input_picker_search"
        style="@style/AdInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="18dp"
        android:hint="搜索名称"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <ListView
            android:id="@+id/list_picker_options"
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:divider="@color/ad_border"
            android:dividerHeight="1dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/text_picker_empty"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="center"
            android:textColor="@color/ad_text_tertiary"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
